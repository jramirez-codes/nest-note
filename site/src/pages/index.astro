---
/**
 * Landing page.
 *
 * A concrete route in src/pages/ takes precedence over Starlight's catch-all,
 * so this fully owns `/`. It deliberately does NOT use the Starlight layout —
 * docs chrome (sidebar, pagination, breadcrumbs) is wrong for a landing page.
 *
 * Every href/src goes through withBase(). See src/lib/url.ts.
 *
 * ── Design ───────────────────────────────────────────────────────────────────
 * The page is a *node-editor canvas*, not a stack of hero cards. A dotted grid
 * runs the full height of the page; the hero leads with real footage — a
 * 49-second unedited capture of the pad (markdown rendering live, `/` opening
 * the palette, /clean rewriting the page) in a phone frame beside the copy —
 * with the live React Flow graph of the whole system as a full-width band
 * beneath it; and each section below reads as zooming into one node of that
 * graph. A dashed "edge" (the spine) threads down the left margin from section
 * to section, with a port dot and a mono tag where each one connects. Content
 * sits in node-cards — mantle panels with hairline borders — so prose, code and
 * diagrams all read as things pinned to the same canvas. Real captures of the
 * app are treated as nodes too, never as a gallery grid: fanned pairs
 * (.phone-pair), a flag-tagged pipeline with dashed port-to-port connectors
 * (.pipeline/.shot/.pipe), and a cue rail that live-syncs to the dictation
 * video (.cues).
 *
 * Lucide icons are part of the canvas grammar, not decoration: 12–15px glyphs
 * in section-tag ports, node title bars (the islands use lucide-react for the
 * same look), chain/panel headings and buttons — always inheriting the text
 * tone next to them, never rendered as large feature icons.
 *
 * Primitives (defined once in <style>, reused everywhere):
 *   .canvas            the content column on the dotted grid
 *   .ns                one section on the spine; .ns-tag its port + mono label
 *   .card              a node panel (mantle bg, hairline border)
 *   .chain             a vertical pipeline of node-cards joined by dashed edges
 *   .btn (+ --primary) the two buttons; .link the inline arrow link
 *
 * ── Islands ──────────────────────────────────────────────────────────────────
 * Four React islands, all `client:visible`:
 *   SystemGraph   — the hero: the whole product as a draggable React Flow graph.
 *   LifecycleFlow — the subject lifecycle played on loop (step rail + React Flow).
 *   CommandDeck   — slash commands as a node inspector (rail + panel).
 *   TrustGraph    — "your laptop is the backend" (React Flow).
 * Only @xyflow/react is heavy, and it loads only when a graph is approached.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import shotPadBlank from '../assets/shots/pad-blank.jpg';
import shotPadMarkdown from '../assets/shots/pad-markdown.jpg';
import shotPalette from '../assets/shots/command-palette.jpg';
import shotDashboard from '../assets/shots/dashboard.jpg';
import shotArchived from '../assets/shots/note-archived-coder.jpg';
import shotCodeAgent from '../assets/shots/code-agent.jpg';
import shotCodeRun from '../assets/shots/code-run.jpg';
import shotCodeView from '../assets/shots/code-view.jpg';
import { withBase } from '../lib/url';
/* Lucide icons are used as small functional glyphs in the canvas language —
 * section-tag ports, node title bars, list markers — never as big decorative
 * feature icons. Sizes stay in the 12–15px band so they read as UI chrome. */
import {
  Archive,
  ArrowLeftRight,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Database,
  FilePlus,
  FileText,
  FolderOpen,
  HardDrive,
  LayoutDashboard,
  Library,
  Lightbulb,
  ListChecks,
  Lock,
  MessageSquareText,
  Mic,
  Move,
  PenLine,
  ShieldCheck,
  SquareSlash,
  Star,
  Workflow,
} from '@lucide/astro';
import SystemGraph from '../components/SystemGraph.tsx';
import LifecycleFlow from '../components/LifecycleFlow.tsx';
import CommandDeck from '../components/CommandDeck.tsx';
import TrustGraph from '../components/TrustGraph.tsx';

const REPO = 'https://github.com/jramirez-codes/ai-notepad';

/* Ordered to retrace the hero capture: it opens on writing, ends on /clean. */
const padFeatures = [
  { icon: FileText, title: 'Live-preview markdown', body: 'The heading and checkboxes in the capture were typed as plain markdown. Marks hide into rendered text, reveal on the line you are editing — and markdown stays the stored format.' },
  { icon: ArrowLeftRight, title: 'Swipe between pages', body: 'Each note is a full-screen page. Swipe left or right through the pad — no file browser, no note list.' },
  { icon: FilePlus, title: 'Tap the blank sheet', body: 'The last page is always blank. Tapping it starts a new note. That is the entire navigation model.' },
];

/* The dictation video's beats. `t` seconds must track the actual recording:
 * dictation types until ~10s, the card runs/thinks until ~21s, then the
 * answer streams. The rail highlights live off video.currentTime. */
const beats = [
  { t: 0, stamp: '00:00', icon: Mic, title: 'You say it', body: '“System command — talk dog, upcoming tasks.” The mic types every word onto the page.' },
  { t: 10, stamp: '00:10', icon: SquareSlash, title: 'The slash runs', body: 'The spoken command becomes a live card on the page. The keyboard never opened.' },
  { t: 21, stamp: '00:21', icon: MessageSquareText, title: 'The answer lands', body: 'The dog subject reports its upcoming tasks, pulled straight off the dashboard.' },
];

const panels = [
  { icon: Library, title: 'Subjects', body: 'Every notebook the orchestrator maintains, with its pages and the tools its MCP server exposes.' },
  { icon: ListChecks, title: 'Tasks', body: 'First-class task cards, including everything /agg-tasks swept out of a subject’s notebook.' },
  { icon: Lightbulb, title: 'Suggestions', body: 'Non-blocking proposals — new servers to create, subjects to merge. Approve or dismiss.' },
  { icon: Archive, title: 'Archived', body: 'Pages lifted off the pad with /archive. Out of the swipe order, never deleted, reopenable in a tap.' },
];

/* Same order as the pipeline captures above: build → run → view. */
const flags = [
  { flag: '-allow-code', body: 'Runs a coding agent with every tool auto-accepted. No per-tool confirmation.' },
  { flag: '-allow-exec', body: 'Runs arbitrary shell commands as you, gated only by the tunnel and token.' },
  { flag: '-allow-view', body: 'Serves previewed dev servers over cleartext HTTP to anyone on your LAN.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ainotepad — notes in, tools out</title>
    <meta
      name="description"
      content="A markdown notepad you flip through page by page. An orchestrator on your own laptop files pages into subjects, subjects grow into queryable MCP servers, and no cloud sits anywhere in the loop."
    />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('starlight-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <header class="nav" data-nav>
      <div class="nav-inner">
        <a class="brand" href={withBase('/')}>
          <Image src={logo} alt="" width={24} height={24} />
          <span>ainotepad</span>
        </a>
        <nav class="nav-links">
          <a href={withBase('/introduction/')}>Docs</a>
          <a href={withBase('/commands/')}>Commands</a>
          <a href={withBase('/architecture/overview/')}>Architecture</a>
          <a href={REPO} rel="noopener">GitHub <ArrowUpRight size={13} class="ext-ic" /></a>
        </nav>
        <a class="btn btn--primary btn--sm nav-cta" href={withBase('/start/install/')}>Get started</a>
      </div>
    </header>

    <main class="canvas">
      <!-- The packet that rides the spine as you scroll — your reading
           position, rendered as data flowing through the page. -->
      <div class="spine-packet" aria-hidden="true" data-packet></div>

      <!-- Hero: copy beside the live system graph ──────────────────────── -->
      <section class="hero" id="overview">
        <div class="hero-copy">
          <p class="tag"><span class="tag-dot"></span>v0 · self-hosted · offline-first</p>
          <h1>Notes in. <em>Tools out.</em></h1>
          <p class="lede">
            A markdown pad you swipe through on your phone. An orchestrator on
            your own laptop files every page into subjects — and the subjects
            you keep returning to compile into MCP servers your model can
            query. No cloud anywhere in the loop.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href={withBase('/start/install/')}>Get started <ArrowRight size={15} /></a>
            <a class="btn" href={withBase('/introduction/')}><BookOpen size={15} /> Read the docs</a>
          </div>
          <p class="hero-meta">React Native · Go · SQLite · MCP · Claude Code</p>
        </div>
        <!-- Real footage first: the app introduces itself before the diagrams
             do. The capture is raw — status bar, keyboard and all. -->
        <figure class="phone-fig hero-demo">
          <div class="phone">
            <video
              src={withBase('/write-demo.mp4')}
              poster={withBase('/write-demo-poster.jpg')}
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Screen recording: markdown typed on the pad renders live — a heading, then real checkboxes — until /clean is typed and Claude rewrites the page into a task list, offered as a change to accept or reject."
              data-autovid
            ></video>
          </div>
          <figcaption>
            One page, start to finish: markdown renders as you type, <code>/</code> opens
            the palette, <code>/clean</code> rewrites the page — and nothing
            lands until you tap <strong>Accept</strong>.
          </figcaption>
        </figure>
        <figure class="hero-graph">
          <SystemGraph client:visible />
          <figcaption>The system, end to end.<span class="drag-hint"> <Move size={12} class="ext-ic" /> Drag the nodes — the page won’t mind.</span></figcaption>
        </figure>
      </section>

      <!-- 01 · Write ───────────────────────────────────────────────────── -->
      <section class="ns" id="write" data-reveal>
        <p class="ns-tag"><PenLine size={12} /> 01 · write</p>
        <div class="ns-head">
          <h2>It starts as paper</h2>
          <p class="sub">
            Everything in the capture above until <code>/clean</code> is just
            the pad doing its day job: a stack of full-screen pages you flip
            through, with markdown that renders as you write it. All of that
            works with no server, no account and no signal — a complete offline
            notepad first, an AI system second.
          </p>
        </div>
        <div class="split split--pad">
          <ol class="chain chain--plain">
            {padFeatures.map(({ icon: Icon, title, body }) => (
              <li>
                <h3><Icon size={14} class="chain-ic" /> {title}</h3>
                <p>{body}</p>
              </li>
            ))}
          </ol>
          <!-- Two real pages of the pad, fanned like the deck you swipe:
               the note from the hero capture mid-write, and the blank sheet
               that is always waiting at the end. -->
          <figure class="phone-fig pad-visual">
            <div class="phone-pair">
              <div class="phone phone--back">
                <Image
                  src={shotPadBlank}
                  alt="The pad’s blank last page: an empty sheet with the page indicator reading 1 of 3, a Dashboard button and the dictation mic."
                  width={480}
                  densities={[1, 2]}
                />
              </div>
              <div class="phone phone--front">
                <Image
                  src={shotPadMarkdown}
                  alt="A note mid-write with the keyboard open: “# Markdown Notes” rendered as a heading above two live checkboxes."
                  width={480}
                  densities={[1, 2]}
                />
              </div>
            </div>
            <figcaption>The same note as the capture above — and the blank sheet waiting at the end of the pad.</figcaption>
          </figure>
        </div>
        <p class="callout">
          <Database size={15} class="callout-ic" /> Everything lives in one <code>ainotepad.sqlite</code> file on the
          device — notes, notebooks, a local FTS5 search index. The server is
          optional; unpaired is the intended fallback, not a degraded mode.
        </p>
      </section>

      <!-- 02 · Organize ────────────────────────────────────────────────── -->
      <section class="ns" id="organize" data-reveal>
        <p class="ns-tag"><Workflow size={12} /> 02 · organize</p>
        <div class="ns-head">
          <h2>Subjects earn their servers</h2>
          <p class="sub">
            A subject starts as a name you mentioned once. Keep returning to it
            and the orchestrator turns it into a real, compiled MCP server the
            model can query — without you writing any of it.
          </p>
        </div>
        <LifecycleFlow client:visible />
        <p class="callout">
          <FolderOpen size={15} class="callout-ic" /> Everything it builds is plain files under <code>~/ainotepad-data</code> —
          notes as markdown pages, servers as Go you can read.
        </p>
        <p class="more"><a class="link" href={withBase('/architecture/overview/')}>How the orchestrator works <ArrowRight size={14} class="link-ic" /></a></p>
      </section>

      <!-- 03 · Command ─────────────────────────────────────────────────── -->
      <section class="ns" id="command" data-reveal>
        <p class="ns-tag"><SquareSlash size={12} /> 03 · command</p>
        <div class="ns-head">
          <h2>Every command is an edge</h2>
          <p class="sub">
            Type a slash command on any page and the result streams into a live
            card, in place — and keeps running when you swipe away. Select one
            to inspect it.
          </p>
        </div>
        <CommandDeck client:visible />
        <p class="aside-label voice-label">No keyboard? Say it.</p>
        <div class="voice">
          <!-- The rail is a miniature of the page spine: ports on a dashed
               edge. It tracks video.currentTime, and clicking a beat seeks. -->
          <ol class="cues" data-cues>
            {beats.map(({ icon: Icon, ...b }) => (
              <li>
                <button type="button" data-seek={b.t}>
                  <span class="cue-time">{b.stamp}</span>
                  <span class="cue-copy">
                    <strong><Icon size={13} class="cue-ic" /> {b.title}</strong>
                    {b.body}
                  </span>
                </button>
              </li>
            ))}
          </ol>
          <figure class="phone-fig voice-stage">
            <div class="phone-pair">
              <div class="phone phone--back">
                <Image
                  src={shotPalette}
                  alt="The pad’s slash-command palette open over a note, suggesting /agg-tasks, /archive, /ask and /chat."
                  width={480}
                  densities={[1, 2]}
                />
              </div>
              <div class="phone phone--front">
                <video
                  src={withBase('/dictation.mp4')}
                  poster={withBase('/dictation-poster.jpg')}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="Screen recording: “/talk dog upcoming tasks” is dictated by voice, lands on the page as text, and Claude’s answer streams into a card."
                  data-dictation
                  data-autovid
                ></video>
              </div>
            </div>
            <figcaption>Dictated end to end — or type <code>/</code> and the palette completes the command.</figcaption>
          </figure>
        </div>
        <p class="more"><a class="link" href={withBase('/commands/')}>All 15 commands <ArrowRight size={14} class="link-ic" /></a></p>
      </section>

      <!-- 04 · Steer ───────────────────────────────────────────────────── -->
      <section class="ns" id="steer" data-reveal>
        <p class="ns-tag"><LayoutDashboard size={12} /> 04 · steer</p>
        <div class="ns-head">
          <h2>The dashboard is the control room</h2>
          <p class="sub">
            The pad is for the page you’re writing now. Everything past it —
            subjects, tasks, open proposals, archived pages — lives on the
            dashboard, where you approve or dismiss what happens next.
          </p>
        </div>
        <div class="steer">
          <div class="panels">
            {panels.map(({ icon: Icon, title, body }) => (
              <div class="card panel">
                <h3><Icon size={15} class="panel-ic" aria-hidden="true" />{title}</h3>
                <p>{body}</p>
              </div>
            ))}
          </div>
          <figure class="phone-fig steer-visual">
            <div class="phone-pair">
              <div class="phone phone--back">
                <Image
                  src={shotArchived}
                  alt="An archived page reopened from the dashboard, holding a finished Claude coding card and a server-run card."
                  width={480}
                  densities={[1, 2]}
                />
              </div>
              <div class="phone phone--front">
                <Image
                  src={shotDashboard}
                  alt="The dashboard: archived pages, tasks sorted by priority with due dates, and tagged ideas."
                  width={480}
                  densities={[1, 2]}
                />
              </div>
            </div>
            <figcaption>The dashboard — and an archived page pulled back open.</figcaption>
          </figure>
        </div>
        <p class="more"><a class="link" href={withBase('/commands/dashboard/')}>Dashboard commands <ArrowRight size={14} class="link-ic" /></a></p>
      </section>

      <!-- 05 · Own it ──────────────────────────────────────────────────── -->
      <section class="ns" id="own" data-reveal>
        <p class="ns-tag"><ShieldCheck size={12} /> 05 · own</p>
        <div class="ns-head">
          <h2>Your laptop is the backend</h2>
          <p class="sub">
            The orchestrator, the generated servers, every command — all backed
            by one small Go binary you run yourself. Your phone connects over a
            pinned-TLS, token-authenticated tunnel, paired once by QR. The model
            runs against your own Claude Code CLI, with your credentials, on
            your machine.
          </p>
        </div>
        <div class="figure">
          <TrustGraph client:visible />
        </div>

        <!-- One real session, told as a pipeline: each capture is a node
             tagged with the flag that unlocks it, wired to the next by a
             dashed edge. Same order as the flags card below. -->
        <p class="aside-label voice-label">One session, three flags — a website from the pad</p>
        <div class="pipeline">
          <figure class="shot">
            <span class="shot-tag">-allow-code</span>
            <div class="phone">
              <Image
                src={shotCodeAgent}
                alt="A /code card on a page: a Claude agent scaffolds a Vite project and runs npm install, with a message box to steer it."
                width={480}
                densities={[1, 2]}
              />
            </div>
            <figcaption>An agent scaffolds the site inside a card — message it mid-run to steer.</figcaption>
          </figure>
          <div class="pipe" aria-hidden="true" style="--lift: 0.65rem"><span>then run it</span></div>
          <figure class="shot" style="--drop: 1.3rem">
            <span class="shot-tag">-allow-exec</span>
            <div class="phone">
              <Image
                src={shotCodeRun}
                alt="A /run card streaming npm run dev output on the pad, with a stdin box and a live view card below."
                width={480}
                densities={[1, 2]}
              />
            </div>
            <figcaption>npm run dev streams back — stdin included, from your phone.</figcaption>
          </figure>
          <div class="pipe" aria-hidden="true" style="--lift: 1.95rem"><span>then see it</span></div>
          <figure class="shot" style="--drop: 2.6rem">
            <span class="shot-tag">-allow-view</span>
            <div class="phone">
              <Image
                src={shotCodeView}
                alt="That dev server mirrored full-screen into the pad through /view, showing the Vite starter page live."
                width={480}
                densities={[1, 2]}
              />
            </div>
            <figcaption>The dev server, mirrored live into the page you’re writing.</figcaption>
          </figure>
        </div>

        <!-- Two closing nodes, styled like the graph nodes above them: a
             title bar with a port dot (peach = flag-gated, mauve = yours),
             then the body. The flag pills repeat the pipeline's tags. -->
        <div class="own-grid">
          <div class="card own-card own-flags">
            <p class="own-head"><Lock size={13} class="own-ic own-ic--warn" aria-hidden="true" />Locked until you unlock them</p>
            <div class="own-body">
              <p class="own-sub">
                The session above ran with all three on. Out of the box, none
                of them exist — each flag unlocks exactly one capability.
              </p>
              <ul class="flag-list">
                {flags.map(f => (
                  <li class="flag">
                    <code class="flag-name">{f.flag}</code>
                    <p>{f.body}</p>
                  </li>
                ))}
              </ul>
              <p class="more"><a class="link" href={withBase('/server/security/')}>Read the security model <ArrowRight size={14} class="link-ic" /></a></p>
            </div>
          </div>
          <div class="card own-card own-install">
            <p class="own-head"><HardDrive size={13} class="own-ic" aria-hidden="true" />Self-host it</p>
            <div class="own-body">
              <p class="own-sub">
                One clone builds both halves — the pad on your phone, the
                server on your laptop.
              </p>
              <pre class="code code--term"><code><span class="term-comment"># the pad</span>
<span class="term-ps">$</span> git clone {REPO}.git
<span class="term-ps">$</span> cd ai-notepad && yarn install && yarn android

<span class="term-comment"># the companion server</span>
<span class="term-ps">$</span> cd server && go run . -root ~/ainotepad-data</code></pre>
              <div class="btn-row">
                <a class="btn btn--primary" href={withBase('/start/install/')}>Full setup guide <ArrowRight size={15} /></a>
                <a class="btn" href={REPO} rel="noopener"><Star size={15} /> Star on GitHub</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <a class="brand" href={withBase('/')}>
          <Image src={logo} alt="" width={20} height={20} />
          <span>ainotepad</span>
        </a>
        <nav class="footer-links">
          <a href={withBase('/introduction/')}>Documentation</a>
          <a href={withBase('/commands/')}>Commands</a>
          <a href={withBase('/server/security/')}>Security</a>
          <a href={REPO} rel="noopener">Source</a>
        </nav>
        <p class="footer-note">Not on any app store — build it yourself.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced) {
          targets.forEach(el => el.classList.add('is-in'));
        } else {
          const observer = new IntersectionObserver(
            entries => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -12% 0px' },
          );
          targets.forEach(el => observer.observe(el));
        }
        // Demo videos (the hero capture and the dictation clip) play only
        // while actually on screen, and not at all under reduced motion —
        // there they become a poster + controls.
        const vids = [...document.querySelectorAll('[data-autovid]')];
        if (reduced) {
          vids.forEach(v => { v.controls = true; });
        } else if (vids.length) {
          const player = new IntersectionObserver(entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                // Autoplay can be blocked (e.g. data saver); fall back to controls.
                entry.target.play().catch(() => { entry.target.controls = true; });
              } else {
                entry.target.pause();
              }
            }
          }, { rootMargin: '80px' });
          vids.forEach(v => player.observe(v));
        }

        const demo = document.querySelector('[data-dictation]');
        if (demo) {
          // The cue rail follows the video, and clicking a beat seeks to it.
          // (A click is a user gesture, so playing is fine under reduced motion.)
          const cueList = document.querySelector('[data-cues]');
          if (cueList) {
            const cues = [...cueList.querySelectorAll('[data-seek]')];
            const follow = () => {
              let now = 0;
              cues.forEach((cue, i) => { if (demo.currentTime >= +cue.dataset.seek - 0.2) now = i; });
              cues.forEach((cue, i) => cue.closest('li').classList.toggle('is-now', i === now));
            };
            demo.addEventListener('timeupdate', follow);
            cues.forEach(cue => cue.addEventListener('click', () => {
              demo.currentTime = +cue.dataset.seek;
              demo.play().catch(() => {});
            }));
            follow();
          }
        }

        const nav = document.querySelector('[data-nav]');

        // The spine packet tracks a probe line 45% down the viewport — your
        // reading position, rendered as data flowing along the spine.
        const canvas = document.querySelector('.canvas');
        const packet = document.querySelector('[data-packet]');
        const sections = [...document.querySelectorAll('.ns')];
        const first = sections[0];
        const last = sections[sections.length - 1];

        const sync = () => {
          nav.classList.toggle('is-stuck', window.scrollY > 8);
          const probe = window.scrollY + innerHeight * 0.45;
          const docTop = el => el.getBoundingClientRect().top + window.scrollY;

          // Clamp the probe to the spine's extent (the spine starts 1rem into
          // the first section and ends 4rem into the last — mirror of the
          // .ns::before rules).
          const start = docTop(first) + 16;
          const end = docTop(last) + 64;
          const y = Math.min(Math.max(probe, start), end) - docTop(canvas);
          packet.style.transform = `translate(-50%, ${y}px)`;
          packet.classList.add('is-live');
        };

        let raf = 0;
        const onSync = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); };
        addEventListener('scroll', onSync, { passive: true });
        addEventListener('resize', onSync, { passive: true });
        sync();
      })();
    </script>

    <!--
      The palette is @import-ed inside this page's own style block rather than a
      top-level `import`. Starlight already loads catppuccin.generated.css via
      `customCss`, so a module-level import here deduplicates into Starlight's
      shared chunk — which this page does not link — and renders unthemed. It
      looks fine in `astro dev` and only breaks in a production build.
    -->
    <style>
      @import '../styles/catppuccin.generated.css';

      /* ── Tokens ──────────────────────────────────────────────────────── */
      :root {
        --frame: 72rem;
        --pad-x: clamp(1.25rem, 4vw, 3rem);
        --sect-y: clamp(4rem, 8vw, 7rem);
        --radius: 0.75rem;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);

        --fg: var(--ctp-text);
        --muted: var(--ctp-subtext0);
        --faint: var(--ctp-overlay0);
        --rule: color-mix(in srgb, var(--ctp-surface1) 55%, transparent);
        --rule-hi: var(--ctp-surface1);
        --panel: color-mix(in srgb, var(--ctp-mantle) 70%, transparent);
        --dot: color-mix(in srgb, var(--ctp-surface1) 50%, transparent);
        --spine-x: 0.75rem;
        --accent: var(--ctp-mauve);
        --warn: var(--ctp-peach);
      }

      /* ── Base: the whole page is a canvas ────────────────────────────── */
      html {
        background-color: var(--ctp-base);
        background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
        background-size: 26px 26px;
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.62;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
        font-feature-settings: 'cv02', 'cv03', 'cv04';
      }
      body { margin: 0; overflow-x: hidden; }
      * { box-sizing: border-box; }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; }

      .mono, .tag, .hero-meta, .ns-tag, .aside-label, .own-head, .flag-name, .cue-time, .shot-tag, .pipe span {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .canvas { max-width: var(--frame); margin-inline: auto; padding: 0 var(--pad-x); position: relative; }

      /* The packet riding the spine — position is set from scroll by JS. */
      .spine-packet {
        position: absolute; top: 0; left: calc(var(--pad-x) + var(--spine-x));
        width: 0.6rem; height: 0.6rem; border-radius: 50%;
        background: var(--accent);
        box-shadow:
          0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent),
          0 0 14px color-mix(in srgb, var(--accent) 55%, transparent);
        transform: translate(-50%, 0);
        transition: transform 120ms linear, opacity 0.4s ease;
        opacity: 0;
        pointer-events: none;
        z-index: 1;
      }
      .spine-packet.is-live { opacity: 1; }

      /* ── Type ────────────────────────────────────────────────────────── */
      h1 {
        font-size: clamp(2.5rem, 5.6vw, 4rem);
        line-height: 1.02;
        letter-spacing: -0.035em;
        font-weight: 640;
        margin: 0;
        text-wrap: balance;
      }
      h1 em { font-style: normal; color: var(--accent); }

      h2 {
        font-size: clamp(1.55rem, 2.9vw, 2.15rem);
        line-height: 1.12;
        letter-spacing: -0.025em;
        font-weight: 620;
        margin: 0 0 0.7rem;
        text-wrap: balance;
      }
      h3 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 0.35rem; }

      .lede { font-size: clamp(1.08rem, 2vw, 1.25rem); color: var(--muted); max-width: 33rem; margin: 1.4rem 0 0; text-wrap: pretty; }
      .sub { color: var(--muted); margin: 0; text-wrap: pretty; }
      .ns p, .split p { color: var(--muted); }
      p code { color: var(--accent); }

      a { color: var(--accent); }
      .link { text-decoration: none; font-weight: 550; }
      .link:hover { text-decoration: underline; text-underline-offset: 3px; }
      .more { margin: 1.6rem 0 0; }

      /* ── Icons ───────────────────────────────────────────────────────── */
      /* Lucide renders inside child components, so these rules need :global.
         Icons are UI chrome: 12–15px, stroke inherits the text tone. */
      :global(.lucide) { flex: none; }
      :global(.ext-ic) { vertical-align: -0.12em; }
      .link :global(.link-ic) { vertical-align: -0.15em; transition: transform 0.18s var(--ease); }
      .link:hover :global(.link-ic) { transform: translateX(2px); }
      .callout :global(.callout-ic) { vertical-align: -0.18em; margin-right: 0.15rem; color: var(--accent); }

      /* ── Buttons ─────────────────────────────────────────────────────── */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        padding: 0.7rem 1.35rem;
        border-radius: 0.5rem;
        border: 1px solid var(--rule-hi);
        background: color-mix(in srgb, var(--ctp-base) 80%, transparent);
        color: var(--fg);
        text-decoration: none;
        font-weight: 550;
        font-size: 0.94rem;
        transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s var(--ease);
      }
      .btn:hover { border-color: var(--accent); transform: translateY(-1px); }
      .btn--sm { padding: 0.48rem 0.95rem; font-size: 0.86rem; }
      .btn--primary {
        background: var(--accent); border-color: var(--accent); color: var(--ctp-base);
        box-shadow: 0 12px 30px -16px color-mix(in srgb, var(--accent) 90%, transparent);
      }
      .btn--primary:hover { background: var(--ctp-lavender); border-color: var(--ctp-lavender); }
      .btn-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

      /* ── Nav ─────────────────────────────────────────────────────────── */
      .nav {
        position: sticky; top: 0; z-index: 20;
        border-bottom: 1px solid transparent;
        transition: border-color 0.25s ease, background-color 0.25s ease;
      }
      .nav.is-stuck { background: color-mix(in srgb, var(--ctp-base) 82%, transparent); backdrop-filter: blur(12px); border-bottom-color: var(--rule); }
      .nav-inner {
        max-width: var(--frame); margin-inline: auto;
        padding: 0.8rem var(--pad-x);
        display: flex; align-items: center; gap: 1.25rem;
      }
      .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 640; color: var(--fg); text-decoration: none; letter-spacing: -0.01em; }
      .nav-links { display: flex; gap: 1.4rem; margin-left: auto; flex-wrap: wrap; }
      .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: color 0.15s ease; }
      .nav-links a:hover { color: var(--fg); }
      .nav-cta { flex: none; }

      /* ── Hero ────────────────────────────────────────────────────────── */
      .hero {
        display: grid; grid-template-columns: 1.1fr 0.9fr;
        gap: clamp(2rem, 4vw, 3.5rem);
        align-items: center;
        padding: clamp(3rem, 6vw, 5.5rem) 0 clamp(3.5rem, 6vw, 5.5rem);
        position: relative;
      }
      .hero::before {
        content: ''; position: absolute; inset: -6rem -20rem 0; pointer-events: none; z-index: -1;
        background: radial-gradient(46rem 30rem at 70% 0%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 65%);
      }
      .tag { display: inline-flex; align-items: center; gap: 0.55rem; margin: 0 0 1.4rem; font-size: 0.72rem; letter-spacing: 0.08em; color: var(--muted); text-transform: uppercase; }
      .tag-dot { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--ctp-green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ctp-green) 22%, transparent); }
      .hero-meta { margin: 1.75rem 0 0; font-size: 0.78rem; letter-spacing: 0.03em; color: var(--faint); }

      /* The hero capture: a real recording of the pad in a phone frame. */
      .hero-demo { justify-self: center; width: clamp(13rem, 26vw, 15.5rem); }
      .hero-demo figcaption { text-align: center; }

      /* The master graph: a full-width band closing the header, the map every
         numbered section below zooms into. */
      .hero-graph { grid-column: 1 / -1; margin: clamp(1rem, 2.5vw, 2rem) 0 0; min-width: 0; }
      .hero-graph figcaption { margin-top: 0.7rem; text-align: center; font-size: 0.8rem; color: var(--faint); }
      /* Dragging is disabled on narrow screens, so don't invite it there. */
      @media (max-width: 60rem) { .drag-hint { display: none; } }

      /* ── Sections on the spine ───────────────────────────────────────── */
      .ns {
        position: relative;
        padding: var(--sect-y) 0 var(--sect-y) 3rem;
      }
      /* The dashed edge threading the sections together. */
      .ns::before {
        content: ''; position: absolute; left: var(--spine-x); top: 0; bottom: 0;
        border-left: 1px dashed var(--rule-hi);
      }
      .ns { scroll-margin-top: 3rem; }
      .ns:first-of-type::before { top: 1rem; }
      .ns:last-of-type::before { bottom: auto; height: 4rem; }

      /* The port where this section connects to the spine. */
      .ns-tag {
        position: relative;
        display: inline-flex; align-items: center; gap: 0.45rem;
        margin: 0 0 1.3rem;
        padding: 0.3rem 0.75rem;
        border: 1px solid var(--rule-hi);
        border-radius: 999px;
        background: var(--ctp-base);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .ns-tag::before {
        content: ''; position: absolute; top: 50%; left: -2.57rem;
        width: 0.65rem; height: 0.65rem; transform: translateY(-50%);
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
      }
      .ns-tag::after {
        content: ''; position: absolute; top: 50%; left: -2rem;
        width: 2rem; border-top: 1px dashed var(--rule-hi);
      }
      .ns-tag :global(.lucide) { color: var(--accent); }

      .ns-head { max-width: 42rem; margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }

      /* ── Cards (node panels) ─────────────────────────────────────────── */
      .card {
        border: 1px solid var(--rule-hi);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 1.35rem 1.5rem;
      }

      /* ── Chain (vertical pipeline of node-cards) ─────────────────────── */
      .chain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.8rem; }
      .chain li {
        position: relative;
        border: 1px solid var(--rule-hi);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 1.1rem 1.3rem;
      }
      .chain li + li::before {
        content: ''; position: absolute; top: -1.8rem; left: 2.1rem; height: 1.8rem;
        border-left: 1px dashed var(--rule-hi);
      }
      .chain li + li::after {
        content: '▾'; position: absolute; top: -1rem; left: 1.83rem;
        color: var(--faint); font-size: 0.75rem; line-height: 1;
      }
      .chain p { margin: 0; font-size: 0.94rem; }
      .chain h3 { display: flex; align-items: center; gap: 0.5rem; }
      .chain h3 :global(.chain-ic) { color: var(--accent); }

      /* ── Splits ──────────────────────────────────────────────────────── */
      .split { display: grid; gap: clamp(1.75rem, 4vw, 3rem); align-items: start; }
      .split--pad { grid-template-columns: 1.05fr 0.95fr; align-items: center; }
      .pad-visual { justify-self: center; }

      .callout {
        margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
        border-left: 2px solid var(--accent);
        padding-left: 1rem;
        max-width: 42rem;
        color: var(--fg) !important;
      }

      .aside-label { margin: 0 0 0.9rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

      /* ── Code block ──────────────────────────────────────────────────── */
      .code {
        margin: 0; padding: 1.3rem 1.45rem;
        border: 1px solid var(--rule-hi); border-radius: var(--radius);
        background: var(--ctp-mantle);
        overflow-x: auto; font-size: 0.85rem; line-height: 1.7;
      }

      /* ── Captures: real app footage, treated as canvas nodes ─────────── */
      .phone {
        border: 1px solid var(--rule-hi);
        border-radius: 1.25rem;
        overflow: hidden;
        background: var(--ctp-crust);
        box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.45);
      }
      .phone img, .phone video { display: block; width: 100%; height: auto; }
      .phone-fig { margin: 0; min-width: 0; }
      .phone-fig figcaption, .shot figcaption {
        margin-top: 0.8rem;
        font-size: 0.8rem;
        color: var(--faint);
        text-wrap: pretty;
      }

      /* Two overlapping phones — echoes the pad's fanned-deck visual. */
      .phone-pair { position: relative; max-width: 24rem; }
      .phone-pair .phone--front { position: relative; width: 70%; z-index: 1; }
      .phone-pair .phone--back {
        position: absolute; top: 2.2rem; right: 0; width: 64%;
        transform: rotate(2.5deg);
        opacity: 0.85;
      }

      /* ── Voice: the cue rail synced to the dictation video ───────────── */
      .voice-label { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
      .voice {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
        gap: clamp(1.75rem, 4vw, 3rem);
        align-items: center;
      }
      .cues { list-style: none; margin: 0; padding: 0; position: relative; display: flex; flex-direction: column; gap: 0.55rem; max-width: 30rem; }
      /* The rail's own dashed edge, a miniature of the page spine. */
      .cues::before {
        content: ''; position: absolute; top: 1.3rem; bottom: 1.3rem; left: 0.42rem;
        border-left: 1px dashed var(--rule-hi);
      }
      .cues li { position: relative; padding-left: 1.55rem; }
      .cues li::before {
        content: ''; position: absolute; left: 0.42rem; top: 1.15rem;
        width: 0.55rem; height: 0.55rem; transform: translateX(-50%);
        border-radius: 50%;
        background: var(--ctp-base);
        border: 1px solid var(--ctp-surface2);
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        z-index: 1;
      }
      .cues li.is-now::before {
        background: var(--accent); border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
      }
      .cues button {
        display: block; width: 100%; text-align: left;
        font: inherit; color: var(--muted);
        background: transparent;
        border: 1px solid transparent; border-radius: 0.6rem;
        padding: 0.7rem 0.9rem;
        cursor: pointer;
        transition: border-color 0.18s ease, background-color 0.18s ease;
      }
      .cues button:hover { border-color: var(--rule-hi); }
      .cues li.is-now button {
        border-color: color-mix(in srgb, var(--accent) 40%, var(--rule-hi));
        background: var(--panel);
      }
      .cue-time { display: block; font-size: 0.66rem; letter-spacing: 0.08em; color: var(--faint); margin-bottom: 0.25rem; transition: color 0.2s ease; }
      .cues li.is-now .cue-time { color: var(--accent); }
      .cue-copy { font-size: 0.88rem; }
      .cue-copy strong { display: flex; align-items: center; gap: 0.45rem; color: var(--fg); font-weight: 600; font-size: 0.95rem; margin-bottom: 0.15rem; }
      .cues :global(.cue-ic) { color: var(--faint); transition: color 0.2s ease; }
      .cues li.is-now :global(.cue-ic) { color: var(--accent); }

      /* ── Pipeline: captures as flag-gated nodes, wired in sequence ───── */
      .pipeline {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        margin-top: 1.4rem;
        /* --drop is a transform, invisible to layout: reserve the room the
           lowest capture actually occupies so it can't overlap what follows. */
        margin-bottom: 3.4rem;
      }
      /* Each capture staggers a little lower than the last (--drop), so the
         row reads as a cascade, not a grid. */
      .shot { position: relative; margin: 0; min-width: 0; transform: translateY(var(--drop, 0rem)); }
      .shot-tag {
        position: absolute; z-index: 2; top: 0; left: 1.1rem;
        transform: translateY(-50%);
        padding: 0.26rem 0.6rem;
        border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--rule-hi));
        border-radius: 999px;
        background: var(--ctp-base);
        font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--warn);
        white-space: nowrap;
      }
      /* The dashed edge between captures: port → dashes → arrowhead. Tilted
         slightly to follow the cascade. */
      .pipe {
        position: relative; align-self: center;
        width: clamp(2.2rem, 3.5vw, 3.6rem); height: 3.2rem;
        transform: translateY(var(--lift, 0rem)) rotate(8deg);
      }
      .pipe::before {
        content: ''; position: absolute; left: 0; right: 0.55rem; top: 50%;
        border-top: 1px dashed var(--rule-hi);
      }
      .pipe::after {
        content: '▸'; position: absolute; right: 0; top: 50%;
        transform: translateY(-55%);
        color: var(--faint); font-size: 0.78rem; line-height: 1;
      }
      .pipe span {
        position: absolute; left: 50%; bottom: calc(50% + 0.4rem);
        transform: translateX(-50%);
        font-size: 0.62rem; letter-spacing: 0.06em; color: var(--faint);
        white-space: nowrap;
      }

      /* ── Dashboard panels ────────────────────────────────────────────── */
      .steer {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
        gap: clamp(1.75rem, 4vw, 3rem);
        align-items: center;
      }
      .steer .panels { grid-template-columns: 1fr; }
      .panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.25rem; }
      .panel h3 { display: flex; align-items: center; gap: 0.6rem; }
      .panel p { margin: 0; font-size: 0.94rem; }
      .panel h3 :global(.panel-ic) { color: var(--accent); }

      /* ── Own it (flags + install): two node-cards with title bars ────── */
      .figure { margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem); }
      .own-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 1.25rem; align-items: stretch; }
      /* The card owns no padding; the title bar and body split it, so the
         hairline under the title runs edge to edge — a node's title bar. */
      .own-card { padding: 0; display: flex; flex-direction: column; }
      .own-head {
        display: flex; align-items: center; gap: 0.6rem;
        margin: 0; padding: 0.8rem 1.4rem;
        border-bottom: 1px solid var(--rule);
        font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--muted);
      }
      .own-head :global(.own-ic) { color: var(--accent); }
      .own-head :global(.own-ic--warn) { color: var(--warn); }
      .own-body { display: flex; flex-direction: column; flex: 1; padding: 1.15rem 1.4rem 1.35rem; }
      .own-sub { margin: 0 0 1rem; font-size: 0.92rem; }
      /* .more / .btn-row pin to the bottom edge so both nodes close level. */
      .own-flags .more { margin-top: auto; padding-top: 1.1rem; }
      .own-install .btn-row { margin-top: auto; padding-top: 1.35rem; }

      .flag-list { list-style: none; margin: 0; padding: 0; }
      .flag { display: grid; grid-template-columns: auto 1fr; gap: 0.95rem; align-items: start; padding: 0.85rem 0; }
      .flag + .flag { border-top: 1px dashed var(--rule); }
      /* Same pill as .shot-tag on the pipeline captures above — the card
         re-lists the exact tags the reader just saw on the footage. */
      .flag-name {
        justify-self: start; margin-top: 0.15rem;
        padding: 0.26rem 0.6rem;
        border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--rule-hi));
        border-radius: 999px;
        background: var(--ctp-base);
        font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--warn); font-weight: 600;
        white-space: nowrap;
      }
      .flag p { margin: 0; font-size: 0.9rem; }

      .code--term { background: var(--ctp-crust); border-color: var(--rule); }
      .term-comment { color: var(--faint); }
      .term-ps { color: var(--accent); user-select: none; }

      /* ── Footer ──────────────────────────────────────────────────────── */
      footer { border-top: 1px solid var(--rule); background: color-mix(in srgb, var(--ctp-base) 70%, transparent); }
      .footer-inner { max-width: var(--frame); margin-inline: auto; padding: 2.5rem var(--pad-x) 3.5rem; display: flex; align-items: center; gap: 1rem 1.75rem; flex-wrap: wrap; }
      .footer-links { display: flex; gap: 1.4rem; flex-wrap: wrap; }
      .footer-links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
      .footer-links a:hover { color: var(--fg); }
      .footer-note { margin: 0 0 0 auto; color: var(--faint); font-size: 0.85rem; }

      /* ── Reveal ──────────────────────────────────────────────────────── */
      .js [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }

      /* Captures cascade in after their section: pipeline shots land one by
         one, then their edges fade in; fanned pairs deal the back phone out
         from under the front one. */
      .js [data-reveal] .shot {
        opacity: 0;
        transform: translateY(calc(var(--drop, 0rem) + 22px));
        transition: opacity 0.65s var(--ease), transform 0.65s var(--ease);
      }
      .js [data-reveal].is-in .shot { opacity: 1; transform: translateY(var(--drop, 0rem)); }
      .js [data-reveal].is-in .shot:nth-of-type(2) { transition-delay: 0.12s; }
      .js [data-reveal].is-in .shot:nth-of-type(3) { transition-delay: 0.24s; }
      .js [data-reveal] .pipe { opacity: 0; transition: opacity 0.5s ease 0.45s; }
      .js [data-reveal].is-in .pipe { opacity: 1; }
      .js [data-reveal] .phone-pair .phone--back {
        opacity: 0;
        transform: translate(-5%, 0) rotate(0deg);
        transition: opacity 0.7s var(--ease) 0.25s, transform 0.7s var(--ease) 0.25s;
      }
      .js [data-reveal].is-in .phone-pair .phone--back { opacity: 0.85; transform: rotate(2.5deg); }

      /* ── Responsive ──────────────────────────────────────────────────── */
      @media (max-width: 60rem) {
        .hero { grid-template-columns: 1fr; }
        .hero-demo { width: min(15.5rem, 72vw); }
        .hero-graph { order: 2; }
        .split--pad, .own-grid, .steer, .voice { grid-template-columns: 1fr; }
        .phone-pair { margin-inline: auto; }

        /* The pipeline goes vertical: same nodes, the edges turn downward. */
        .pipeline { grid-template-columns: 1fr; justify-items: center; gap: 0.6rem; margin-bottom: 1.4rem; }
        .pipeline .shot { --drop: 0rem; width: 100%; max-width: 16rem; }
        .pipe { transform: none; align-self: auto; width: auto; height: 2.6rem; }
        .pipe::before { left: 50%; right: auto; top: 0.1rem; bottom: 0.8rem; border-top: 0; border-left: 1px dashed var(--rule-hi); }
        .pipe::after { content: '▾'; right: auto; left: 50%; top: auto; bottom: 0; transform: translateX(-50%); }
        .pipe span { left: calc(50% + 0.9rem); bottom: auto; top: 40%; transform: translateY(-50%); }
      }

      @media (max-width: 46rem) {
        :root { --spine-x: 0.35rem; }
        .ns { padding-left: 2.1rem; }
        .ns-tag::before { left: -2.07rem; width: 0.55rem; height: 0.55rem; }
        .ns-tag::after { left: -1.5rem; width: 1.5rem; }
        .nav-links { gap: 1rem; }
        .nav-cta { display: none; }
        .phones--2, .phones--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .flag { grid-template-columns: 1fr; gap: 0.45rem; }
        .btn-row .btn { flex: 1 1 100%; }
        .footer-note { margin-left: 0; width: 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }
    </style>
  </body>
</html>
