---
/**
 * Shell for the landing page: document head, nav, the canvas that all
 * sections render into, footer, page-level behavior, and the shared visual
 * primitives every landing component builds on.
 *
 * It deliberately does NOT use the Starlight layout — docs chrome (sidebar,
 * pagination, breadcrumbs) is wrong for a landing page.
 *
 * Primitives (defined once in the <style> below, reused by all landing
 * components):
 *   .canvas            the content column on the dotted grid
 *   .ns                one section on the spine; .ns-tag its port + mono label
 *                      (rendered by SpineSection.astro)
 *   .card              a node panel (mantle bg, hairline border)
 *   .chain             a vertical pipeline of node-cards joined by dashed edges
 *   .btn (+ --primary) the buttons; .link the inline arrow link
 *   .phone/.phone-pair real captures framed as canvas nodes (PhonePair.astro)
 *
 * Section-specific styles live in each section component's own is:global
 * style block. Everything is global on purpose: the reveal cascade and spine
 * selectors cross component boundaries (html.js, [data-reveal] on sections),
 * which Astro's scoped styles cannot express.
 */
import LandingFooter from './LandingFooter.astro';
import LandingNav from './LandingNav.astro';
import { withBase } from '../../lib/url';
---

<!-- data-theme is baked into the markup: the site is dark-only, and an
     attribute (unlike the docs' ThemeProvider script) holds without JS. -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NestNote — notes in, tools out</title>
    <meta
      name="description"
      content="A markdown notepad you flip through page by page. An orchestrator on your own laptop files pages into subjects, subjects grow into queryable MCP servers, and no cloud sits anywhere in the loop."
    />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <LandingNav />

    <main class="canvas">
      <!-- The packet that rides the spine as you scroll — your reading
           position, rendered as data flowing through the page. -->
      <div class="spine-packet" aria-hidden="true" data-packet></div>
      <slot />
    </main>

    <LandingFooter />

    <script is:inline>
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced) {
          targets.forEach(el => el.classList.add('is-in'));
        } else {
          const observer = new IntersectionObserver(
            entries => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -12% 0px' },
          );
          targets.forEach(el => observer.observe(el));
        }
        // Demo videos (the hero capture and the dictation clip) play only
        // while actually on screen, and not at all under reduced motion —
        // there they become a poster + controls.
        const vids = [...document.querySelectorAll('[data-autovid]')];
        if (reduced) {
          vids.forEach(v => { v.controls = true; });
        } else if (vids.length) {
          const player = new IntersectionObserver(entries => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                // Autoplay can be blocked (e.g. data saver); fall back to controls.
                entry.target.play().catch(() => { entry.target.controls = true; });
              } else {
                entry.target.pause();
              }
            }
          }, { rootMargin: '80px' });
          vids.forEach(v => player.observe(v));
        }

        const nav = document.querySelector('[data-nav]');

        // The spine packet tracks a probe line 45% down the viewport — your
        // reading position, rendered as data flowing along the spine.
        const canvas = document.querySelector('.canvas');
        const packet = document.querySelector('[data-packet]');
        const sections = [...document.querySelectorAll('.ns')];
        const first = sections[0];
        const last = sections[sections.length - 1];

        const sync = () => {
          nav.classList.toggle('is-stuck', window.scrollY > 8);
          const probe = window.scrollY + innerHeight * 0.45;
          const docTop = el => el.getBoundingClientRect().top + window.scrollY;

          // Clamp the probe to the spine's extent (the spine starts 1rem into
          // the first section and ends 4rem into the last — mirror of the
          // .ns::before rules).
          const start = docTop(first) + 16;
          const end = docTop(last) + 64;
          const y = Math.min(Math.max(probe, start), end) - docTop(canvas);
          packet.style.transform = `translate(-50%, ${y}px)`;
          packet.classList.add('is-live');
        };

        let raf = 0;
        const onSync = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); };
        addEventListener('scroll', onSync, { passive: true });
        addEventListener('resize', onSync, { passive: true });
        sync();
      })();
    </script>

    <!--
      The palette is @import-ed inside this style block rather than a top-level
      `import`. Starlight already loads catppuccin.generated.css via
      `customCss`, so a module-level import here deduplicates into Starlight's
      shared chunk — which this page does not link — and renders unthemed. It
      looks fine in `astro dev` and only breaks in a production build.
    -->
    <style is:global>
      @import '../../styles/catppuccin.generated.css';

      /* ── Tokens ──────────────────────────────────────────────────────── */
      :root {
        --frame: 72rem;
        --pad-x: clamp(1.25rem, 4vw, 3rem);
        --sect-y: clamp(4rem, 8vw, 7rem);
        --radius: 0.75rem;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        --fg: var(--ctp-text);
        --muted: var(--ctp-subtext0);
        --faint: var(--ctp-overlay0);
        --rule: color-mix(in srgb, var(--ctp-surface1) 55%, transparent);
        --rule-hi: var(--ctp-surface1);
        --panel: color-mix(in srgb, var(--ctp-mantle) 70%, transparent);
        --dot: color-mix(in srgb, var(--ctp-surface1) 50%, transparent);
        --spine-x: 0.75rem;
        --accent: var(--ctp-mauve);
        --warn: var(--ctp-peach);
      }

      /* ── Base: the whole page is a canvas ────────────────────────────── */
      html {
        background-color: var(--ctp-base);
        background-image: radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
        background-size: 26px 26px;
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.62;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
        font-feature-settings: 'cv02', 'cv03', 'cv04';
      }
      body { margin: 0; overflow-x: hidden; }
      * { box-sizing: border-box; }
      code { font-family: var(--font-mono); font-size: 0.9em; }

      .canvas { max-width: var(--frame); margin-inline: auto; padding: 0 var(--pad-x); position: relative; }

      /* The packet riding the spine — position is set from scroll by JS. */
      .spine-packet {
        position: absolute; top: 0; left: calc(var(--pad-x) + var(--spine-x));
        width: 0.6rem; height: 0.6rem; border-radius: 50%;
        background: var(--accent);
        box-shadow:
          0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent),
          0 0 14px color-mix(in srgb, var(--accent) 55%, transparent);
        transform: translate(-50%, 0);
        transition: transform 120ms linear, opacity 0.4s ease;
        opacity: 0;
        pointer-events: none;
        z-index: 1;
      }
      .spine-packet.is-live { opacity: 1; }

      /* ── Type ────────────────────────────────────────────────────────── */
      h1 {
        font-size: clamp(2.5rem, 5.6vw, 4rem);
        line-height: 1.02;
        letter-spacing: -0.035em;
        font-weight: 640;
        margin: 0;
        text-wrap: balance;
      }
      h1 em { font-style: normal; color: var(--accent); }

      h2 {
        font-size: clamp(1.55rem, 2.9vw, 2.15rem);
        line-height: 1.12;
        letter-spacing: -0.025em;
        font-weight: 620;
        margin: 0 0 0.7rem;
        text-wrap: balance;
      }
      h3 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 0.35rem; }

      .sub { color: var(--muted); margin: 0; text-wrap: pretty; }
      .ns p, .split p { color: var(--muted); }
      p code { color: var(--accent); }

      a { color: var(--accent); }
      .link { text-decoration: none; font-weight: 550; }
      .link:hover { text-decoration: underline; text-underline-offset: 3px; }
      .more { margin: 1.6rem 0 0; }

      .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 640; color: var(--fg); text-decoration: none; letter-spacing: -0.01em; }

      /* ── Icons ───────────────────────────────────────────────────────── */
      /* Icons are UI chrome: 12–15px, stroke inherits the text tone. */
      .lucide { flex: none; }
      .ext-ic { vertical-align: -0.12em; }
      .link .link-ic { vertical-align: -0.15em; transition: transform 0.18s var(--ease); }
      .link:hover .link-ic { transform: translateX(2px); }

      /* ── Buttons ─────────────────────────────────────────────────────── */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        padding: 0.7rem 1.35rem;
        border-radius: 0.5rem;
        border: 1px solid var(--rule-hi);
        background: color-mix(in srgb, var(--ctp-base) 80%, transparent);
        color: var(--fg);
        text-decoration: none;
        font-weight: 550;
        font-size: 0.94rem;
        transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s var(--ease);
      }
      .btn:hover { border-color: var(--accent); transform: translateY(-1px); }
      .btn--sm { padding: 0.48rem 0.95rem; font-size: 0.86rem; }
      .btn--primary {
        background: var(--accent); border-color: var(--accent); color: var(--ctp-base);
        box-shadow: 0 12px 30px -16px color-mix(in srgb, var(--accent) 90%, transparent);
      }
      .btn--primary:hover { background: var(--ctp-lavender); border-color: var(--ctp-lavender); }
      .btn-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

      /* ── Sections on the spine ───────────────────────────────────────── */
      .ns {
        position: relative;
        padding: var(--sect-y) 0 var(--sect-y) 3rem;
      }
      /* The dashed edge threading the sections together. */
      .ns::before {
        content: ''; position: absolute; left: var(--spine-x); top: 0; bottom: 0;
        border-left: 1px dashed var(--rule-hi);
      }
      .ns { scroll-margin-top: 3rem; }
      .ns:first-of-type::before { top: 1rem; }
      .ns:last-of-type::before { bottom: auto; height: 4rem; }

      /* The port where this section connects to the spine. */
      .ns-tag {
        position: relative;
        display: inline-flex; align-items: center; gap: 0.45rem;
        margin: 0 0 1.3rem;
        padding: 0.3rem 0.75rem;
        border: 1px solid var(--rule-hi);
        border-radius: 999px;
        background: var(--ctp-base);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .ns-tag::before {
        content: ''; position: absolute; top: 50%; left: -2.57rem;
        width: 0.65rem; height: 0.65rem; transform: translateY(-50%);
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
      }
      .ns-tag::after {
        content: ''; position: absolute; top: 50%; left: -2rem;
        width: 2rem; border-top: 1px dashed var(--rule-hi);
      }
      .ns-tag .lucide { color: var(--accent); }

      .ns-head { max-width: 42rem; margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }

      /* ── Cards (node panels) ─────────────────────────────────────────── */
      .card {
        border: 1px solid var(--rule-hi);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 1.35rem 1.5rem;
      }

      /* ── Chain (vertical pipeline of node-cards) ─────────────────────── */
      .chain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.8rem; }
      .chain li {
        position: relative;
        border: 1px solid var(--rule-hi);
        border-radius: var(--radius);
        background: var(--panel);
        padding: 1.1rem 1.3rem;
      }
      .chain li + li::before {
        content: ''; position: absolute; top: -1.8rem; left: 2.1rem; height: 1.8rem;
        border-left: 1px dashed var(--rule-hi);
      }
      .chain li + li::after {
        content: '▾'; position: absolute; top: -1rem; left: 1.83rem;
        color: var(--faint); font-size: 0.75rem; line-height: 1;
      }
      .chain p { margin: 0; font-size: 0.94rem; }
      .chain h3 { display: flex; align-items: center; gap: 0.5rem; }
      .chain h3 .chain-ic { color: var(--accent); }

      /* ── Splits ──────────────────────────────────────────────────────── */
      .split { display: grid; gap: clamp(1.75rem, 4vw, 3rem); align-items: start; }

      .aside-label { margin: 0 0 0.9rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
      /* An aside that follows another block instead of opening a section. */
      .aside-label--gap { margin-top: clamp(2.5rem, 5vw, 3.5rem); }

      /* ── Code block ──────────────────────────────────────────────────── */
      .code {
        margin: 0; padding: 1.3rem 1.45rem;
        border: 1px solid var(--rule-hi); border-radius: var(--radius);
        background: var(--ctp-mantle);
        overflow-x: auto; font-size: 0.85rem; line-height: 1.7;
      }

      /* ── Captures: real app footage, treated as canvas nodes ─────────── */
      .phone {
        border: 1px solid var(--rule-hi);
        border-radius: 1.25rem;
        overflow: hidden;
        background: var(--ctp-crust);
        box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.45);
      }
      .phone img, .phone video { display: block; width: 100%; height: auto; }
      .phone-fig { margin: 0; min-width: 0; }
      .phone-fig figcaption, .shot figcaption {
        margin-top: 0.8rem;
        font-size: 0.8rem;
        color: var(--faint);
        text-wrap: pretty;
      }

      /* Two overlapping phones — echoes the pad's fanned-deck visual. */
      .phone-pair { position: relative; max-width: 24rem; }
      .phone-pair .phone--front { position: relative; width: 70%; z-index: 1; }
      .phone-pair .phone--back {
        position: absolute; top: 2.2rem; right: 0; width: 64%;
        transform: rotate(2.5deg);
        opacity: 0.85;
      }

      /* ── Reveal ──────────────────────────────────────────────────────── */
      .js [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }

      /* Captures cascade in after their section: pipeline shots land one by
         one, then their edges fade in; fanned pairs deal the back phone out
         from under the front one. (.shot/.pipe live in OwnSection — the
         cascade is a page-level system, so it stays defined here.) */
      .js [data-reveal] .shot {
        opacity: 0;
        transform: translateY(calc(var(--drop, 0rem) + 22px));
        transition: opacity 0.65s var(--ease), transform 0.65s var(--ease);
      }
      .js [data-reveal].is-in .shot { opacity: 1; transform: translateY(var(--drop, 0rem)); }
      .js [data-reveal].is-in .shot:nth-of-type(2) { transition-delay: 0.12s; }
      .js [data-reveal].is-in .shot:nth-of-type(3) { transition-delay: 0.24s; }
      .js [data-reveal] .pipe { opacity: 0; transition: opacity 0.5s ease 0.45s; }
      .js [data-reveal].is-in .pipe { opacity: 1; }
      .js [data-reveal] .phone-pair .phone--back {
        opacity: 0;
        transform: translate(-5%, 0) rotate(0deg);
        transition: opacity 0.7s var(--ease) 0.25s, transform 0.7s var(--ease) 0.25s;
      }
      .js [data-reveal].is-in .phone-pair .phone--back { opacity: 0.85; transform: rotate(2.5deg); }

      /* ── Responsive ──────────────────────────────────────────────────── */
      @media (max-width: 60rem) {
        .phone-pair { margin-inline: auto; }
      }

      @media (max-width: 46rem) {
        :root { --spine-x: 0.35rem; }
        .ns { padding-left: 2.1rem; }
        .ns-tag::before { left: -2.07rem; width: 0.55rem; height: 0.55rem; }
        .ns-tag::after { left: -1.5rem; width: 1.5rem; }
        .btn-row .btn { flex: 1 1 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }
    </style>
  </body>
</html>
