{
  "name": "nestnote-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page and documentation for NestNote. Independent sub-project — not part of the React Native app's dependency graph.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen:theme": "node scripts/gen-theme-css.mjs",
    "check:theme": "npm run gen:theme && git ls-files --error-unmatch src/styles/catppuccin.generated.css > /dev/null && git diff --exit-code -- src/styles/catppuccin.generated.css",
    "predev": "npm run gen:theme",
    "prebuild": "npm run gen:theme",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "0.41.3",
    "@lucide/astro": "^1.25.0",
    "@xyflow/react": "^12.11.2",
    "astro": "7.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "starlight-links-validator": "0.25.2",
    "typescript": "^6.0.3"
  }
}
