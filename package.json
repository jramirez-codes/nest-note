{
  "name": "ainotepad",
  "version": "0.0.1",
  "private": true,
  "op-sqlite": {
    "fts5": true
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "apk:build": "cd android && ./gradlew assembleDebug",
    "apk:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "apk": "yarn apk:build && yarn apk:install",
    "apk:build:release": "cd android && ./gradlew assembleRelease",
    "apk:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "apk:release": "yarn apk:build:release && yarn apk:install:release",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "server:build": "cd server && go build -o ainotepad-server .",
    "server:start": "cd server && go run . -root /home/user/Documents/ai-notes-data/  -allow-exec -allow-code",
    "server:remote": "cd server && go run . -root /home/user/Documents/ai-notes-data/ -advertise-host \"$(tailscale ip -4 | head -n1)\"  -allow-exec -allow-code",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^17.1.1",
    "@react-native/new-app-screen": "0.86.0",
    "lucide-react-native": "^1.23.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "^4.7.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
